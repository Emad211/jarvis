#!/data/data/com.termux/files/usr/bin/sh
# Usage: phone-screenshot [out.png]  — capture the screen via rish (no adb needed).
. "$HOME/.local/bin/phone-env"
OUT="${1:-$HOME/shots/shot_$(date +%Y%m%d_%H%M%S).png}"
mkdir -p "$(dirname "$OUT")"
rish -c "screencap -p /sdcard/Download/.hermes_shot.png" || exit 1
cp /sdcard/Download/.hermes_shot.png "$OUT" || exit 1
echo "MEDIA:$OUT"
